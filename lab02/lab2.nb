Cell[CellGroupData[{

Cell["\<\
Zadanie 2. Rozwi\:0105zywanie r\[OAcute]wna\:0144, liczba \
rozwi\:0105za\:0144, Solve, Plot, Reduce, Epilog, Manipulate\
\>", "Section",
 CellChangeTimes->{{3.9695871300552654`*^9, 
  3.9695871431152306`*^9}},ExpressionUUID->"ea3873e9-30fa-4a42-94b3-\
ae9c77622811"],

Cell[TextData[{
 "Zdefiniuj funkcje ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "3"], "+", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "-", "4", 
         StyleBox["x", "TI"], "-", "4"}], TraditionalForm], "errors" -> {}, 
     "input" -> "f(x) = x^3 + x^2 -4x - 4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9ea1817f-af3e-4105-9dbb-e273962c2316"],
 " (jak w poprzednim zadaniu) oraz ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "+", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g(x) = x^2 + a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "092e1abc-d8b3-4d5d-9994-d49880b32946"],
 ", \[LineSeparator]gdzie \|01d44e jest parametrem rzeczywistym. "
}], "Text",
 CellChangeTimes->{
  3.969587190152296*^9, {3.969587268349533*^9, 3.9695872721955967`*^9}, {
   3.969693659723153*^9, 3.9696936829156713`*^9}, {3.969693852898632*^9, 
   3.969693914657256*^9}},ExpressionUUID->"3df8e860-7871-4546-93cf-\
2d432c4dbb8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "^", "3"}], " ", "+", " ", 
   RowBox[{"x", "^", "2"}], " ", "-", 
   RowBox[{"4", "x"}], " ", "-", " ", "4"}]}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"4afa229e-e229-4841-b9fc-882efe60c585"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
