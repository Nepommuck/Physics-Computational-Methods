Cell[CellGroupData[{

Cell["4) Zautomatyzowa\[CAcute] proces generowania wykresu", "Subsection",
 CellChangeTimes->{
  3.96980018204414*^9},ExpressionUUID->"a2b77e1b-9bad-4aed-aa94-77b05365e775"],

Cell["\<\
Zautomatyzowa\[CAcute] proces generowania wykresu z punktu 3) tak by \
mo\:017cna by\[LSlash]o go otrzyma\[CAcute] dla wielomianu \:210e(\|01d465) z \
nowo wylosowanymi miejscami zerowymi.\
\>", "Text",
 CellChangeTimes->{{3.969800172159338*^9, 3.9698002395714607`*^9}, {
  3.96980106944347*^9, 
  3.9698010698179083`*^9}},ExpressionUUID->"c98c2d5a-2f14-454b-a40f-\
e4a7678dddfb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GeneratePolynomialAndPlot", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"roots", " ", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "10"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"x", " ", "-", " ", 
          RowBox[{"roots", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "roots", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aValues", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "0.01"}], ",", " ", "0.01", ",", " ", "0.0005"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nSol", " ", "=", " ", 
       RowBox[{"Map", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"a", " ", "|->", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"Solve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"h", "[", "x", "]"}], " ", "==", " ", "a"}], ",", " ", 
               RowBox[{"{", "x", "}"}], ",", " ", "Reals"}], "]"}], "]"}]}], 
           "}"}]}], ",", "\[IndentingNewLine]", "aValues"}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
       RowBox[{"nSol", ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{
            RowBox[{"Length", "[", "roots", "]"}], " ", "+", " ", "1"}]}], 
          "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"AxesLabel", "\[Rule]", 
         RowBox[{"{", 
          
          RowBox[{"\"\<a\>\"", ",", 
           " ", "\"\<Liczba rozwi\:0105za\:0144 h(x) = a\>\""}], "}"}]}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.96980042403607*^9, 3.969800480005808*^9}, {
  3.969800524140644*^9, 3.969800545850271*^9}, {3.969800639144545*^9, 
  3.969800649828784*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"cc690c80-81b4-44dc-a419-8925d07937bf"],

Cell[TextData[{
 "Nast\:0119pnie utworzy\[CAcute] list\:0119 ",
 Cell[BoxData[
 "pSol"], "InlineCode",ExpressionUUID->"84f3bd7c-5112-4e42-b371-967da3995644"],
 " zawieraj\:0105c\:0105 wykresy jak w punkcie 3) dla 9-ciu  \
r\[OAcute]\:017cnych wielomian\[OAcute]w \:210e(\|01d465)  z wylosowanymi \
miejscami zerowymi."
}], "Text",
 CellChangeTimes->{{3.96980110240795*^9, 
  3.969801104811516*^9}},ExpressionUUID->"5d531b2a-d3b1-4c12-be49-\
31f8de0915e1"],

