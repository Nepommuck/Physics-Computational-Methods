Cell[TextData[{
 "Rozwa\:017c r\[OAcute]wnanie dla wielomianu \|01d45b-tego stopnia postaci ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            StyleBox["n", "TI"], "-", "1"}]], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          RowBox[{
            StyleBox["n", "TI"], "-", "1"}]], "+", "...", "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "1"], 
         StyleBox["x", "TI"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "0"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "x^n + a_{n-1} x ^{n-1} + ... + a_1 x + a_0 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bef0388d-cdb3-454c-bf5e-3496fa0d2fba"],
 ".\[LineSeparator]Dla jakich warto\:015bci \|01d45b istniej\:0105 \
og\[OAcute]lne wzory na rozwi\:0105zanie tego r\[OAcute]wnania? Sprawd\:017a \
w Mathematica\[RegisteredTrademark] dla kilku\nwybranych warto\:015bci \
\|01d45b."
}], "Text",
