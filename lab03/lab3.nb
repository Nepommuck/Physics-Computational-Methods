Cell[TextData[{
 "Zdefiniuj proces, w kt\[OAcute]rym kulka porusza si\:0119 po osi liczb ca\
\[LSlash]kowitych, wykonuj\:0105c skoki w lewo (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["x", "TI"], "\[LongEqual]", "-1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta x = -1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fce024f-c704-489a-a073-3fa3eb0933bb"],
 ") albo w prawo (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["x", "TI"], "\[LongEqual]", "+1"}], TraditionalForm], 
