Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["S", "TI"], 
         StyleBox["n", "TI"]], "\[LongEqual]", 
        UnderoverscriptBox["\[Sum]", 
         RowBox[{
           StyleBox["k", "TI"], "\[LongEqual]", "0"}], 
         StyleBox["n", "TI"], LimitsPositioning -> True], 
        RowBox[{"(", 
          RowBox[{
            FractionBox["4", 
             RowBox[{"8", 
               StyleBox["k", "TI"], "+", "1"}]], "-", 
            FractionBox["2", 
             RowBox[{"8", 
               StyleBox["k", "TI"], "+", "4"}]], "-", 
            FractionBox["1", 
             RowBox[{"8", 
               StyleBox["k", "TI"], "+", "5"}]], "-", 
            FractionBox["1", 
             RowBox[{"8", 
               StyleBox["k", "TI"], "+", "6"}]]}], ")"}], 
        SuperscriptBox["16", 
         RowBox[{"-", 
           StyleBox["k", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
    "input" -> 
    "S_n = \\sum_{k=0}^n ( \\frac{4}{8k+1} - \\frac{2}{8k+4} - \
\\frac{1}{8k+5} - \\frac{1}{8k+6} ) 16^{-k}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"56695dcf-21e1-4709-ae18-cae00a0b75bb"]], \
"Text",
 CellChangeTimes->{{3.970197182564748*^9, 
  3.970197190268618*^9}},ExpressionUUID->"32135d29-2aff-437f-aa53-\
b700201fc513"],

Cell[TextData[{
 "jest zbie\:017cny dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n \\to \\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "40abf0ac-a8d8-472a-9ea3-2d5b1837f078"],
 " ? U\:017cyj funkcji SumConvergence."
}], "Text",
 CellChangeTimes->{{3.970197193099522*^9, 
  3.970197216781693*^9}},ExpressionUUID->"d086be13-fbc7-4c55-bf2e-\
1bcbdeffe8b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "k_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"8", "k"}], "+", "1"}], ")"}]}], " ", "-", " ", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"8", "k"}], "+", "4"}], ")"}]}], " ", "-", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"8", "k"}], "+", "5"}], ")"}]}], " ", "-", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"8", "k"}], "+", "6"}], ")"}]}]}], ")"}], " ", "*", " ", 
   RowBox[{"16", "^", 
    RowBox[{"(", 
     RowBox[{"-", "k"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9701974721230717`*^9, 3.970197490418165*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"e941db97-4e3a-4b39-b4f2-f1ff8fe09d47"],

