Cell["Co sugeruje ten wykres?", "Text",
 CellChangeTimes->{
  3.970157050730815*^9, {3.97015722694099*^9, 3.970157292728932*^9}, {
   3.970157395597494*^9, 3.970157396379682*^9}, {3.9701574295264587`*^9, 
   3.9701574543708878`*^9}, {3.9702167168570557`*^9, 
   3.970216720942971*^9}},ExpressionUUID->"5a44719d-e20b-4324-b85c-\
7e4ff3e3e598"],

Cell[TextData[{
 "Odp.: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             UnderscriptBox["lim", 
              RowBox[{
                StyleBox["k", "TI"], "\[Rule]", "\[Infinity]"}], 
              LimitsPositioning -> True], "ln", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["S", "TI"], 
                  StyleBox["k", "TI"]], "-", "1"}], ")"}], "\[LongEqual]", 
             "-", "\[Infinity]"}], ")"}], "\[DoubleRightArrow]", 
         RowBox[{"(", 
           RowBox[{
             UnderscriptBox["lim", 
              RowBox[{
                StyleBox["k", "TI"], "\[Rule]", "\[Infinity]"}], 
              LimitsPositioning -> True], 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["S", "TI"], 
                  StyleBox["k", "TI"]], "-", "1"}], ")"}], "\[LongEqual]", 
             "0"}], ")"}], "\[DoubleRightArrow]", 
         RowBox[{"(", 
           RowBox[{
             UnderscriptBox["lim", 
              RowBox[{
                StyleBox["k", "TI"], "\[Rule]", "\[Infinity]"}], 
              LimitsPositioning -> True], 
             SubscriptBox[
              StyleBox["S", "TI"], 
              StyleBox["k", "TI"]], "\[LongEqual]", "1"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(\\lim_{k \\to \\infty} \\ln{(S_k - 1)} = -\\infty) \\Rightarrow \
(\\lim_{k \\to \\infty} (S_k - 1) = 0) \\Rightarrow (\\lim_{k \\to \\infty} \
S_k = 1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "12a137b4-5c1f-49f6-80ef-988c3f8f6643"]
}], "Text",
 CellChangeTimes->{
  3.970216719787724*^9},ExpressionUUID->"da71960c-e91d-4432-b2e7-\
ac160427d7bf"],

Cell[TextData[{
 "Jaka jest granica ci\:0105gu ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["S", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "S_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8409817d-bcf3-42df-8133-67adaaa7df9a"],
 " dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[Rule]", "\[Infinity]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k \\to \\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26c1f166-43c6-49f4-a2c0-238d4fbd8aed"],
 "? "
}], "Text",
 CellChangeTimes->{
  3.970157402904907*^9},ExpressionUUID->"9b588356-7c13-4de4-b10e-\
3f01692880a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{"S", "[", "k", "]"}], ",", " ", 
   RowBox[{"k", " ", "->", " ", "Infinity"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.970157193815278*^9, 3.970157216547018*^9}, {
  3.9701572997936172`*^9, 3.970157299971489*^9}},
