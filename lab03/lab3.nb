    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b6e80c3-2a87-4f50-9ac4-a8e1dd56c395"],
 ") z takim samym prawdopodobie\:0144stwem ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["L", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["R", "TI"]], "\[LongEqual]", "0.5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_L = p_R = 0.5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2206583-80fb-417d-a0ac-33eb583cf194"],
 ".\[LineSeparator]Je\:015bli kulka zaczyna b\[LSlash]\:0105dzenie w punkcie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5eb3a7d8-09b7-4ddb-8537-5813e091c0a3"],
 ", to jakie jest prawdopodobie\:0144stwo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
