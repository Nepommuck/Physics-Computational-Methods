 "Animate"], "InlineCode",ExpressionUUID->
  "ad7c88c2-236a-ee47-b0ba-34537fdd8703"]
}], "Subsection",
 CellChangeTimes->{{3.97080067524765*^9, 
  3.9708006990331917`*^9}},ExpressionUUID->"6793f244-fd54-594f-b192-\
d8dfa87e0850"],

Cell[TextData[{
 "Stw\[OAcute]rz animacj\:0119 b\[LSlash]\:0105dzenia przypadkowego przy \
pomocy funkcji ",
 Cell[BoxData[
 "Animate"], "InlineCode",ExpressionUUID->
  "4d683449-6df6-9543-b83a-f8e39c5b029a"],
 " pokazuj\:0105c\:0105 jak przebiega b\[LSlash]\:0105dzenie przypadkowe w \
kolejnych skokach od 1 do \|01d45b = 10000.\nWykorzystaj wykres z ",
 StyleBox["pkt. 1)",
  FontWeight->"Bold"],
 " dla zwi\:0119kszaj\:0105cej si\:0119 liczby pokazanych punkt\[OAcute]w \
