Cell[CellGroupData[{

Cell["Zadanie 2. Pochodna jako granica, notacja, Limit, D", "Section",
 CellChangeTimes->{{3.9708019520513077`*^9, 
  3.9708019623566856`*^9}},ExpressionUUID->"d9091c09-010e-4541-8fc9-\
f9095a3ca459"],

Cell[TextData[{
 "Pochodn\:0105 funkcji ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], "\[LongEqual]", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "y = f(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9a9abd92-2467-0140-8f88-78895539dfa4"],
 " w punkcie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "caf7a5a9-a028-064d-a4e9-115e0abcbe98"],
 " nazywamy granic\:0119 (o ile istnieje):"
}], "Text",
 CellChangeTimes->{{3.970801979314436*^9, 
  3.970802011396303*^9}},ExpressionUUID->"a201d03d-f212-024c-901d-\
a54259814c24"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox[
         StyleBox["f", "TI"], "\[Prime]"], 
        RowBox[{"(", 
          SubscriptBox[
           StyleBox["x", "TI"], "0"], ")"}], "\[LongEqual]", 
        UnderscriptBox["lim", 
         RowBox[{"\[CapitalDelta]", 
           StyleBox["x", "TI"], "\[Rule]", "0"}], LimitsPositioning -> True], 
        FractionBox[
         RowBox[{
           StyleBox["f", "TI"], 
           RowBox[{"(", 
             RowBox[{
               SubscriptBox[
                StyleBox["x", "TI"], "0"], "+", "\[CapitalDelta]", 
               StyleBox["x", "TI"]}], ")"}], "-", 
           StyleBox["f", "TI"], 
           RowBox[{"(", 
             SubscriptBox[
              StyleBox["x", "TI"], "0"], ")"}]}], 
         RowBox[{"\[CapitalDelta]", 
           StyleBox["x", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
    "input" -> 
    "f'(x_0) = \\lim_{\\Delta x \\to 0} \\frac{ f(x_0 + \\Delta x) - f(x_0) \
}{ \\Delta x }", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"97a4ebb2-1772-a04e-9403-cdc3be509e21"]], \
"Text",
 CellChangeTimes->{{3.970802033375736*^9, 3.970802044471466*^9}},
 TextAlignment->Center,ExpressionUUID->"36a9c3fd-8b2b-c546-adaf-5e71b8e16ccb"],

Cell[TextData[{
 "Co symbolicznie zapisuje si\:0119 m.in. jako ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["f", "TI"], "\[Prime]"], "(", 
         SubscriptBox[
          StyleBox["x", "TI"], "0"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "f'(x_0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27642683-e9a9-2e46-8da3-ea047460f06b"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["y", "TI"], "\[Prime]"], "(", 
         SubscriptBox[
          StyleBox["x", "TI"], "0"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "y'(x_0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ddca1aa8-c5e9-de4f-89d3-94f408ecacd4"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", FontSlant -> "Plain"], 
            StyleBox["f", "TI"]}], 
          RowBox[{
            StyleBox["d", FontSlant -> "Plain"], 
            StyleBox["x", "TI"]}]], 
         SubscriptBox["|", 
          RowBox[{
            StyleBox["x", "TI"], "\[LongEqual]", 
            SubscriptBox[
             StyleBox["x", "TI"], "0"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "\\frac{ \\mathrm{d} f }{ \\mathrm{d} x } |_{ x = x_0 }", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99b5984b-7dcc-0b4b-ad61-f4e248d61d93"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          StyleBox["d", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["d", FontSlant -> "Plain"], 
            StyleBox["x", "TI"]}]], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         SubscriptBox["|", 
          RowBox[{
            StyleBox["x", "TI"], "\[LongEqual]", 
            SubscriptBox[
             StyleBox["x", "TI"], "0"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "\\frac{ \\mathrm{d} }{ \\mathrm{d} x } f(x) |_{ x = x_0 }", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4454db8-4d64-b34b-a2c8-120a5c05c65b"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["x", "TI"]], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["x", "TI"], "0"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "D_x f(x_0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6767751b-6ac2-45c9-96b0-7391bd89c145"],
 ".\nJe\:015bli pochodna jest po czasie spotyka si\:0119 te\:017c zapis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["f", "TI"], "."], "(", 
         SubscriptBox[
          StyleBox["x", "TI"], "0"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\dot f(x_0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3e1405ca-6819-41dd-971f-799ecc7f86b2"],
 "."
}], "Text",
 CellChangeTimes->{
  3.9708019895604076`*^9, {3.9708021725004654`*^9, 3.9708021991773987`*^9}, {
   3.9708022317628403`*^9, 3.970802261700777*^9}, {3.9708023461231956`*^9, 
   3.9708023722750835`*^9}, {3.9708277708674097`*^9, 
   3.9708277758674593`*^9}, {3.970827978218368*^9, 
   3.970827992296423*^9}},ExpressionUUID->"7b1b8553-502b-a748-bd6b-\
39a1943d65c9"],

Cell[TextData[{
 "Policz pochodn\:0105 dla przyk\[LSlash]adowej funkcji ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "f(x) = a x^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a423f69e-a501-6840-b789-5c9db3ac6e05"],
 " korzystaj\:0105c z r\[OAcute]\:017cnych notacji w Mathematica\
\[RegisteredTrademark]:"
}], "Text",
 CellChangeTimes->{{3.9708029925623837`*^9, 
  3.970803000267597*^9}},ExpressionUUID->"90b7ca73-fe9f-f94a-8364-\
20c6b17ef2fc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "n", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], " ", "=", " ", 
  RowBox[{"a", " ", 
