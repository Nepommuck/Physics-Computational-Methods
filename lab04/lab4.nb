Cell[TextData[{
 "Przedstawi\[CAcute] na wykresie funkcj\:0119 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88db5e5a-20a5-aa4e-8a83-c4735c0de96e"],
 ", wyznaczon\:0105 styczn\:0105 oraz zaznaczy\[CAcute] punkt \
styczno\:015bci. Prosz\:0119 wykona\[CAcute] wykres w zakresie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-4", "\[LessEqual]", 
         StyleBox["x", "TI"], "\[LessEqual]", "8"}], TraditionalForm], 
     "errors" -> {}, "input" -> "-4 \\le x \\le 8", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4841e351-0781-aa47-a2d5-4cbeb2003a68"],
 "."
}], "Text",
