Cell[CellGroupData[{
Cell["Zestaw 4", "Title",
 CellChangeTimes->{{3.970798784700304*^9, 
  3.97079879103203*^9}},ExpressionUUID->"fece17cd-321a-c449-b633-\
84258a651667"],

Cell[CellGroupData[{

Cell[TextData[{
 "Zadanie 1. B\[LSlash]\:0105dzenie przypadkowe w 2D oraz 3D, ",
 Cell[BoxData[
 "RandomChoice"], "InlineCode",ExpressionUUID->
  "99ebe331-4a20-c049-8107-21db65e4b945"],
 ", ",
 Cell[BoxData[
 "Position"], "InlineCode",ExpressionUUID->
  "c1b82926-7447-0345-ae34-ab01e62f5ee1"],
 ", oraz inne "
}], "Section",
 CellChangeTimes->{{3.9707988029000683`*^9, 
  3.9707988434775105`*^9}},ExpressionUUID->"f9dc25d0-8411-8641-964f-\
772b11169c9f"],

Cell["\<\
Zadanie jest kontynuacj\:0105 zad. 5 z zestawu nr 3, \
\:201eB\[LSlash]\:0105dzenie przypadkowe w 1D\[CloseCurlyDoubleQuote].
Analogicznie do b\[LSlash]\:0105dzenia przypadkowego w 1D zdefiniujmy \
dyskretne b\[LSlash]\:0105dzenie kulki w dw\[OAcute]ch wymiarach.
\
\>", "Text",
 CellChangeTimes->{3.9707988460124893`*^9, 
  3.9707988768393536`*^9},ExpressionUUID->"60508638-e753-d943-9a70-\
ebdf0710d4b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getSteps", "[", "n_", "]"}], ":=", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Minus]", "1"}], ",", "1"}], "}"}], ",", " ", "n"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"getWalk", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"steps", ",", "walk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"steps", "=", 
      RowBox[{"getSteps", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"walk", "=", 
      RowBox[{"Accumulate", "[", "steps", "]"}]}], ";", "\[IndentingNewLine]",
      "walk"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9707989503908386`*^9, 3.9707989510484295`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"53d9bcc9-5565-9946-92b3-987fe1b9bb78"],

Cell[TextData[{
 "Kulka wykonuje skoki w lewo, w prawo, w d\[OAcute]\[LSlash] oraz w g\
\[OAcute]r\:0119 z takim samym prawdopodobie\:0144stwem ",
 StyleBox["0.25",
  FontWeight->"Bold"],
 ".\nPrzyk\[LSlash]adowo skok w prawo mo\:017cna przedstawi\[CAcute] jako ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{"\[CapitalDelta]", 
             StyleBox["x", "TI"], ",", "\[CapitalDelta]", 
             StyleBox["y", "TI"]}], "}"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\{ \\Delta x, \\Delta y \\} = \\{1, 0\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57f41b8d-f5ee-3643-a13c-b8687f62e87c"],
 ", a skok w g\[OAcute]r\:0119 jako ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{"\[CapitalDelta]", 
             StyleBox["x", "TI"], ",", "\[CapitalDelta]", 
             StyleBox["y", "TI"]}], "}"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\{ \\Delta x, \\Delta y \\} = \\{0, 1\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "468bc62d-2603-9644-b5d5-036d1eb62af0"],
 ".\nAnalogicznie do funkcji ",
 Cell[BoxData[
  RowBox[{"getSteps", "[", "n_", "]"}]], "InlineCode",ExpressionUUID->
  "a7e4aef1-b398-d248-b127-ba85f40b4011"],
 " oraz ",
 Cell[BoxData[
  RowBox[{"getWalk", "[", "n_", "]"}]], "InlineCode",ExpressionUUID->
  "dcab3d25-3228-0a49-82d0-bd2f06d8ced9"],
 " dla 1D zdefiniuj funkcje ",
 Cell[BoxData[
  RowBox[{"getSteps2D", "[", "\|01d45b\|01d45b_", "]"}]], "InlineCode",
  ExpressionUUID->"606b8828-64fa-b94e-a112-5a70df665e9f"],
 " oraz ",
 Cell[BoxData[
  RowBox[{"getWalk2D", "[", "n_", "]"}]], "InlineCode",ExpressionUUID->
  "9af03bc9-c0bc-444a-a62f-0b84bb77db0b"],
 " zwracaj\:0105ce pozycj\:0119 kulki po 1, 2, \[Ellipsis] \|01d45b skokach."
}], "Text",
 CellChangeTimes->{
  3.970798880183613*^9, {3.9707989722847767`*^9, 3.970798976311878*^9}, {
   3.970800491669716*^9, 3.970800504802889*^9}, {3.970800553588646*^9, 
   3.970800612737253*^9}},ExpressionUUID->"2b632564-211e-fc4e-b33d-\
d04ea7e20083"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getSteps2D", "[", "n_", "]"}], ":=", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Minus]", "1"}], ",", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", " ", "n"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"getWalk2D", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"steps", ",", "walk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"steps", "=", 
      RowBox[{"getSteps2D", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"walk", "=", 
      RowBox[{"Accumulate", "[", "steps", "]"}]}], ";", "\[IndentingNewLine]",
      "walk"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9707991037282696`*^9, 3.9707991980345497`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"631b0b3c-587f-5240-838f-418be9648a33"],

