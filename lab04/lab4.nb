  3.970804723128887*^9}},ExpressionUUID->"e0dc2509-780d-1a42-a748-\
6b60a0d476d2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{"Sin", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sA", " ", "=", " ", 
   RowBox[{
    RowBox[{"f", "'"}], "[", "x0", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sB", " ", "=", " ", 
   RowBox[{
    RowBox[{"f", "[", "x0", "]"}], " ", "-", " ", 
    RowBox[{"sA", " ", "x0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "[", "x_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"sA", " ", "x"}], " ", "+", " ", "sB"}]}]}], "Input",
