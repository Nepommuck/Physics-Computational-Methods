Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fvbBase", "[", "t_", "]"}], "[", 
     RowBox[{
     "m_", ",", " ", "k_", ",", " ", "b_", ",", " ", "x0_", ",", " ", "v0_"}],
      "]"}], " ", ":=", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fBase", "[", "t", "]"}], "[", 
       RowBox[{
       "m", ",", " ", "k", ",", " ", "b", ",", " ", "x0", ",", " ", "v0"}], 
       "]"}], ",", " ", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fvb", "[", 
    RowBox[{"t_", ",", " ", "m_", ",", " ", "b_"}], "]"}], " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "x0", ",", " ", "v0"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"k", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"x0", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"v0", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fvbBase", "[", "t", "]"}], "[", 
       RowBox[{
       "m", ",", " ", "k", ",", " ", "b", ",", " ", "x0", ",", " ", "v0"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
