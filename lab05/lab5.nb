Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fBase", "[", "t1_", "]"}], "[", 
     RowBox[{
     "m_", ",", " ", "k_", ",", " ", "b_", ",", " ", "x0_", ",", " ", "v0_"}],
      "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "solution", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"solution", " ", "=", " ", 
        RowBox[{"DSolve", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"m", " ", 
              RowBox[{
               RowBox[{"x", "''"}], "[", "t", "]"}]}], " ", "==", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "b"}], " ", 
               RowBox[{
                RowBox[{"x", "'"}], "[", "t", "]"}]}], " ", "-", " ", 
              RowBox[{"k", " ", 
               RowBox[{"x", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "x0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "0", "]"}], " ", "==", " ", "v0"}]}], 
           "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", "x", ",",
           " ", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Last", "[", 
         RowBox[{"First", "[", 
          RowBox[{"Flatten", "[", "solution", "]"}], "]"}], "]"}], "[", "t1", 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"t_", ",", " ", "m_", ",", " ", "b_"}], "]"}], " ", "=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "x0", ",", " ", "v0"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x0", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"v0", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"k", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fBase", "[", "t", "]"}], "[", 
      RowBox[{
      "m", ",", " ", "k", ",", " ", "b", ",", " ", "x0", ",", " ", "v0"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
