Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"x", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "b"}], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["b", "m"]}], "-", 
             FractionBox[
              SqrtBox[
               RowBox[{
                SuperscriptBox["b", "2"], "-", 
                RowBox[{"4", " ", "k", " ", "m"}]}]], "m"]}], ")"}], " ", 
           "t"}]], " ", "x0"}], "+", 
        RowBox[{"b", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["b", "m"]}], "+", 
             FractionBox[
              SqrtBox[
               RowBox[{
                SuperscriptBox["b", "2"], "-", 
                RowBox[{"4", " ", "k", " ", "m"}]}]], "m"]}], ")"}], " ", 
           "t"}]], " ", "x0"}], "+", 
