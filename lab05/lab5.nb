Cell[CellGroupData[{

Cell[TextData[{
 "3) Przedstaw przybli\:017cenia funkcji ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], "(", "\[Theta]", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "f( \\theta )", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3494f94c-9fb1-45ba-9a80-e503f0fd7df8"],
 " na powy\:017cszym wykresie"
}], "Subsection",
 CellChangeTimes->{{3.9718641873167686`*^9, 
  3.97186423736922*^9}},ExpressionUUID->"1a8e3804-3bcd-41f3-bdb3-\
ac8e0d74ce37"],

Cell["\<\
Wystarcz\:0105 tylko parzyste stopnie, dlaczego? 
Niech przybli\:017cenia b\:0119d\:0105 wyrysowane lini\:0105 przerywan\:0105. \
Wygodnie u\:017cy\[CAcute] funkcji Show. \
\>", "Text",
 CellChangeTimes->{{3.97186421469873*^9, 
  3.971864228534732*^9}},ExpressionUUID->"73ea6f3f-fb3b-41c5-aeb1-\
e1f4da6a2f7d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"degrees", " ", "=", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"2", ",", " ", "10", ",", " ", "2"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DegreeToFunction", "[", "degree_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "g", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "[", "t_", "]"}], " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"f", "[", "t", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "theta0", ",", " ", "degree"}], "}"}]}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", "g"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aproxFunctions", " ", "=", " ", 
    RowBox[{"Map", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"degree", " ", "|->", " ", 
       RowBox[{"DegreeToFunction", "[", "degree", "]"}]}], ",", 
      "\[IndentingNewLine]", "degrees"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aproxPlot", " ", "=", " ", 
    RowBox[{"Plot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"Map", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"function", " ", "|->", " ", 
          RowBox[{"function", "[", "theta", "]"}]}], ",", 
         "\[IndentingNewLine]", "functions"}], "\[IndentingNewLine]", "]"}], 
       "]"}], ",", "\[IndentingNewLine]", "thetaRange"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"plot", ",", " ", "aproxPlot"}], "]"}]}], "Input",
 CellChangeTimes->{{3.971865011561699*^9, 3.971865256901662*^9}, {
