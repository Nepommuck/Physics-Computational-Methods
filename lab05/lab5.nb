  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"m", " ", 
       RowBox[{
        RowBox[{"x", "''"}], "[", "t", "]"}]}], " ", "==", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "b"}], " ", 
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}]}], " ", "-", " ", 
       RowBox[{"k", " ", 
        RowBox[{"x", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "x0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "0", "]"}], " ", "==", " ", "y0"}]}], 
