Cell[TextData[{
 "5) Zbadaj jaka jest r\[OAcute]\:017cnica ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], "(", "\[Theta]", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "f( \\theta )", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28c15379-3797-4ae9-9b05-217f0b2b52d9"],
 " oraz przybli\:017ce\:0144 kolejnych stopni w punkcie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", "\[LongEqual]", 
         FractionBox["\[Pi]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\theta = \\frac{ \\pi }{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41279f94-2ed7-4876-b50d-bd773ca0bd73"]
}], "Subsection",
