 RowBox[{
  RowBox[{
   RowBox[{"theta1", " ", "=", " ", 
    RowBox[{"Pi", " ", "/", " ", "2"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CalculateError", "[", "degree_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"AproxFunction", ",", " ", "error"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"AproxFunction", "[", "t_", "]"}], " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"f", "[", "t", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "theta0", ",", " ", "degree"}], "}"}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"error", " ", "=", " ", 
       RowBox[{"N", " ", "@", " ", 
        RowBox[{"Abs", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"AproxFunction", "[", "theta1", "]"}], " ", "-", " ", 
            RowBox[{"f", "[", "theta1", "]"}]}], ")"}], " ", "/", " ", 
          RowBox[{"f", "[", "theta1", "]"}]}], "\[IndentingNewLine]", 
         "]"}]}]}], ";", "\[IndentingNewLine]", "error"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", "\[IndentingNewLine]", 
