Cell[TextData[{
 "3) Wykonaj wykres fazowy dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "m = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ae1d7c5-c2b5-40fd-80a1-8f663bfe77c9"],
 " oraz warto\:015bci ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6fe0e1bc-36b1-4686-8a3f-f9d26b03559c"],
 " jak w punkcie ",
 StyleBox["2)",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.971422970774036*^9, 
  3.9714229966413*^9}},ExpressionUUID->"4d35f804-4a6d-472d-a59a-ed7cf8e2508b"],

Cell["\<\
W tym przypadku wykres fazowy to  zale\:017cno\:015b\[CAcute] pr\:0119dko\
\:015bci od po\[LSlash]o\:017cenia  klocka.\
\>", "Text",
 CellChangeTimes->{{3.971422980259521*^9, 3.971423022569653*^9}, {
