Cell[BoxData[
 RowBox[{"Map", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"tuple", " ", "|->", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "integralTo5", ",", " ", "integralToInf"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "integralTo5", ",", " ", "integralToInf"}], 
         "}"}], " ", "=", " ", "tuple"}], ";", "\[IndentingNewLine]", 
       RowBox[{"k", "  ", "->", " ", 
        RowBox[{"PercentForm", "[", 
