  3.972207405422763*^9}},ExpressionUUID->"ef5ebe05-bbde-4311-b374-\
5df0ac081cfa"],

Cell[TextData[{
 "W tym celu zdefiniowa\[CAcute] interesuj\:0105cy nas region \
korzystaj\:0105c z ",
 Cell[BoxData[
 "ImplicitRegion"], "InlineCode",ExpressionUUID->
  "b1601909-b1e5-4b8c-9793-68f77c75e9fd"],
 " a nast\:0119pnie wyznaczy\[CAcute] pole korzystaj\:0105c z funkcji Area."
}], "Text",
