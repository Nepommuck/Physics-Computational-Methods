Cell[CellGroupData[{

Cell[TextData[{
 "2) Odczyta\[CAcute] z wykresu lub znale\:017a\[CAcute] przy pomocy ",
 Cell[BoxData[
 "Solve"], "InlineCode",ExpressionUUID->
  "e9e6a0f2-f582-4a98-96a7-07b1045f1c2b"],
 " miejsca przeci\:0119cia obu krzywych"
}], "Subsection",
 CellChangeTimes->{{3.972206775575774*^9, 
  3.972206782623019*^9}},ExpressionUUID->"91c2c5f0-e6e0-455a-a21d-\
633cb9802f30"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solutions", " ", "=", " ", 
  RowBox[{"Map", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solution", " ", "|->", " ", 
     RowBox[{"Last", "[", "solution", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"b", "[", "x", "]"}], " ", "==", " ", 
        RowBox[{"t", "[", "x", "]"}]}], ",", " ", "x", ",", " ", "Reals"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{3.972206829574806*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"adf87473-e079-4f97-9047-b54d599f5f10"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "1"}], ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.972206830041226*^9, 3.972209398602906*^9, 
  3.972209870444305*^9, 3.97220993283351*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"86f8208b-d380-4b50-b04f-dd4911304309"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "3) U\:017cy\[CAcute] wyznaczonego w ",
 StyleBox["2)",
  FontWeight->"Bold"],
 " zakresu warto\:015bci ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> "x", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4defccbf-0088-492a-9f98-2f43f66dcf2e"],
 " do obliczenia pola powierzchni mi\:0119dzy tymi krzywymi"
}], "Subsection",
 CellChangeTimes->{{3.972206855038445*^9, 
  3.972206894425191*^9}},ExpressionUUID->"a0f25441-01a3-4038-9a46-\
b6289e673741"],

Cell[TextData[{
 "U\:017cy\[CAcute] wyznaczonego w ",
 StyleBox["2)",
  FontWeight->"Bold"],
 " zakresu warto\:015bci ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> "x", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bfb6618-3e93-4a43-86f1-01a32aafde87"],
 " do obliczenia pola powierzchni mi\:0119dzy tymi krzywymi jako \
ca\[LSlash]ki oznaczonej z ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["2", 
          RowBox[{
            SuperscriptBox[
             StyleBox["x", "TI"], "2"], "+", "1"}]], "-", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{2}{ x^2 + 1} - x^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5b510694-e37c-4ad1-a233-31dbeb8aee62"],
 " . Zapisa\[CAcute] wynik."
}], "Text",
 CellChangeTimes->{{3.972206890780789*^9, 3.9722069023290567`*^9}, 
   3.9722069333740873`*^9},ExpressionUUID->"8a7fbc99-0be8-4ef9-8b75-\
347ff132288c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"areaIntegral", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"t", "[", "x", "]"}], " ", "-", " ", 
     RowBox[{"b", "[", "x", "]"}]}], ",", " ", "xRange"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.972206945589181*^9, 3.972206987655158*^9}, {
  3.972207349806464*^9, 3.972207351445936*^9}, {3.972208076493092*^9, 
