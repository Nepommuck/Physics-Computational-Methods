Cell[CellGroupData[{

Cell[TextData[{
 "3) Nast\:0119pnie policz ca\[LSlash]ki oznaczone ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["k", "TI"]}], ")"}], 
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\int_0^{\\infty} f(x, k) \\mathrm{d} x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "362d4a06-e684-4a15-87c3-1b28ac9feb4e"],
 " dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "2", ",", 
         "\[Ellipsis]", ",", "6"}], TraditionalForm], "errors" -> {}, "input" -> 
     "k = 1, 2,  \\dotsc, 6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d3ef308-4cbe-442d-a9ee-d79586a3b202"]
}], "Subsection",
 CellChangeTimes->{{3.9720155921632977`*^9, 3.9720156079824295`*^9}, {
  3.972202734823797*^9, 
  3.972202745719172*^9}},ExpressionUUID->"08281665-fe34-774b-8eec-\
791468f101c5"],

Cell[TextData[{
 "Wyniki zapisz jako lista ",
 Cell[BoxData[
 "poleDoInf"], "InlineCode",ExpressionUUID->
  "a0f4ec26-d54b-4c41-a2fe-859bebbbd2b4"],
 "."
}], "Text",
 CellChangeTimes->{{3.972015609838028*^9, 
  3.972015616992462*^9}},ExpressionUUID->"d7e29b98-9b10-934b-9667-\
3120272b7b16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"poleDoInf", " ", "=", "  ", 
  RowBox[{"Map", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", " ", "|->", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", ",", " ", "k"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], 
    ",", "\[IndentingNewLine]", "kValues"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.972015624516819*^9, 3.9720156541620827`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"d58eef24-197b-dc4a-9567-a61a1ae54055"],

Cell[BoxData[
 TemplateBox[{
  "Integrate", "idiv", 
   "\"Integral of \\!\\(\\*FractionBox[\\\"1\\\", RowBox[{\\\"1\\\", \
\\\"+\\\", \\\"x\\\"}]]\\) does not converge on \\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{\\\"0\\\", \\\",\\\", \\\"\[Infinity]\\\"}], \\\"}\\\"}]\\).\"", 2, 
   24, 1, 19258386782674689984, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.9720156552487087`*^9, 3.972202940122848*^9, 
  3.972209397383759*^9, 3.972209869152505*^9, 3.972209931596918*^9},
 CellLabel->
  "During evaluation of \
In[24]:=",ExpressionUUID->"6b581bb1-78a7-40e0-b475-25a527460fd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
    RowBox[{
     FractionBox["1", 
      RowBox[{"1", "+", "x"}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], ",", 
   FractionBox["\[Pi]", "2"], ",", 
   FractionBox[
    RowBox[{"2", " ", "\[Pi]"}], 
    RowBox[{"3", " ", 
     SqrtBox["3"]}]], ",", 
   FractionBox["\[Pi]", 
    RowBox[{"2", " ", 
     SqrtBox["2"]}]], ",", 
   RowBox[{
    FractionBox["1", "5"], " ", 
    RowBox[{"Gamma", "[", 
     FractionBox["1", "5"], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     FractionBox["4", "5"], "]"}]}], ",", 
   FractionBox["\[Pi]", "3"]}], "}"}]], "Output",
 CellChangeTimes->{3.9720156560255203`*^9, 3.972202941414015*^9, 
  3.972209398268094*^9, 3.972209870166769*^9, 3.972209932477106*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"8cf7c650-a721-4b2b-b133-c38cc21a175f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"poleDoInf", " ", "=", " ", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"{", "Infinity", "}"}], ",", " ", 
    RowBox[{"N", " ", "@", " ", 
     RowBox[{"poleDoInf", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;"}], "]"}], "]"}]}]}], "]"}]}]], "Input",
