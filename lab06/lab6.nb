Cell[CellGroupData[{

Cell[TextData[{
 "4) Wynik z ",
 StyleBox["3)",
  FontWeight->"Bold"],
 " mo\:017cna uzyska\[CAcute] r\[OAcute]wnie\:017c inaczej za pomoc\:0105 \
wbudowanych funkcji okre\:015blaj\:0105cych obszar (region) geometryczny"
}], "Subsection",
