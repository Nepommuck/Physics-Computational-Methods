Cell[TextData[{
 "Jaki jest stosunek pola pod krzyw\:0105 dla ca\[LSlash]ki liczonej do ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", "5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x = 5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "597d150c-ab09-1b40-ba44-d0dc78ee4314"],
 " do pola dla ca\[LSlash]ki liczonej do ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "x = \\infty", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a6cb0d1-c339-4c45-9b9c-b25195fd6ec2"],
 " przy rosn\:0105cym ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b5f4b1e-b468-c245-b5d3-5c7f93565bfa"],
 "?\nIle wynosi ten stosunek dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "2", ",", 
         "\[Ellipsis]", ",", "6"}], TraditionalForm], "errors" -> {}, "input" -> 
     "k = 1, 2,  \\dotsc, 6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ef8ad85-787d-6843-bd44-8f0411f97af5"],
 ".\nCo dzieje si\:0119 przy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96c1a98c-01fe-c341-b924-1f13f6f349eb"],
 "?"
}], "Text",
