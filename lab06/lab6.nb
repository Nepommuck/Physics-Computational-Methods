Cell[TextData[{
 "Jaka by\[LSlash]a warto\:015b\[CAcute] ca\[LSlash]ki? Czy mo\:017cna to by\
\[LSlash]o wywnioskowa\[CAcute] bez liczenia ca\[LSlash]ki?\n",
 StyleBox["Odp:",
  FontWeight->"Bold"],
 " Tak, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "f_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8afc9d44-7e35-47c5-844d-1203aef94079"],
 " jest funkcj\:0105 nieparzyst\:0105, wi\:0119c ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[ForAll]", 
          RowBox[{
            StyleBox["a", "TI"], "\[Element]", 
            SubscriptBox[
             StyleBox["R", FontSlant -> "Plain"], "+"]}]], 
         SubsuperscriptBox["\[Integral]", 
          RowBox[{"-", 
            StyleBox["a", "TI"]}], 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["x", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\forall_{a \\in \\mathbb{R}_+} \\int_{-a}^a f_n(x) \\mathrm{d} x = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96169d9b-74c4-4c58-9fe0-5a054643874d"],
 " "
}], "Text",
 CellChangeTimes->{
  3.9720127082415695`*^9, {3.972202172612608*^9, 3.9722022039271507`*^9}, 
   3.97220224375686*^9, 
   3.972202337597826*^9},ExpressionUUID->"aef9614b-4569-7248-9b6b-\
9b20b471ecc2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "3) Oblicz ca\[LSlash]k\:0105 nieoznaczon\:0105 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["p", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\int f_p(x) \\mathrm{d} x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "baf6ff4a-6fae-2144-b0dc-106ce9eacdaa"]
}], "Subsection",
 CellChangeTimes->{{3.972012756922806*^9, 3.9720127652142715`*^9}, {
   3.9720128004434967`*^9, 3.9720128437634716`*^9}, 3.9720128830740757`*^9, {
   3.972202113388986*^9, 
   3.972202116278797*^9}},ExpressionUUID->"ac13f1af-7928-ff42-b738-\
c742b472bd03"],

Cell[TextData[{
 "gdzie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["p", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "+", "4", "cos", 
         RowBox[{"(", 
           RowBox[{"5", 
             StyleBox["x", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "f_p(x) = x^2 + 4 \\cos{( 5x )}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "44f06f2f-ed4a-4161-89ed-9f20284e6a13"]
}], "Text",
 CellChangeTimes->{
  3.972202118286824*^9},ExpressionUUID->"3a3e86b3-ce9d-409c-98d6-\
d603c62bd2af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fp", "[", "x_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "^", "2"}], " ", "+", " ", 
   RowBox[{"4", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"5", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"fp", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9720128967233086`*^9, 3.972012929607342*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"9e26ab80-acd7-1f4f-ba7b-348c552b2d6a"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   SuperscriptBox["x", "3"], "3"], "+", 
  RowBox[{
   FractionBox["4", "5"], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"5", " ", "x"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.972012930167076*^9, 3.972202929999242*^9, 
  3.972209389927265*^9, 3.972209862209326*^9, 3.972209923244722*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"79c3109d-eb8f-4d1d-af45-07fe50c37685"]
}, Open  ]]
}, Open  ]],

