         SubsuperscriptBox["\[Integral]", 
          StyleBox["a", "TI"], 
          StyleBox["b", "TI"]], 
         StyleBox["x", "TI"], 
         SqrtBox[
          RowBox[{"1", "+", 
            SuperscriptBox[
             RowBox[{"[", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["f", "TI"], "\[Prime]"], "(", 
                 StyleBox["x", "TI"], ")"}], "]"}], "2"]}]], 
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x_{ \\text{CM} } = \\frac{1}{l} \\int_a^b x \\sqrt{ 1 + [f'(x)]^2 } \
