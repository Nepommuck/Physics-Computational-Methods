 RowBox[{
  RowBox[{"fn", "[", "x_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "^", "3"}], " ", "+", " ", 
   RowBox[{"4", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"5", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"fn", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], "Input",
