Cell[TextData[{
 "Oblicz ca\[LSlash]k\:0105 oznaczon\:0105 z ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["n", "TI"]], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "f_n(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d583436-979c-465f-8a26-6eabec16b217"],
 " w zakresie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-5", "\[LessEqual]", 
         StyleBox["x", "TI"], "\[LessEqual]", "5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "-5 \\le x \\le 5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e6dc0ca-a991-4c8d-a013-55f5d54374f6"],
 ", tj. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", "-5", "5"], 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\int_{-5}^5 f_n(x) \\mathrm{d} x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "664190de-b701-4094-af07-20331173ddc2"]
}], "Text",
 CellChangeTimes->{{3.972012687515312*^9, 3.9720126988601265`*^9}, {
  3.972202051195684*^9, 3.9722020642487507`*^9}, {3.972202129142057*^9, 
  3.9722021323299437`*^9}},ExpressionUUID->"686b523b-3e1b-2949-b3bf-\
ef74f909b92b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"fn", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "5"}], ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.972012712786335*^9, 3.9720127271425724`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"b86d17e2-5a33-f34c-abed-906e5762d816"],

