Cell[TextData[{
 "1) Oblicz ca\[LSlash]k\:0105 nieoznaczon\:0105 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\int f_n(x) \\mathrm{d} x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "924a767f-15ca-f945-989e-b2f1bc6db524"]
}], "Subsection",
