Cell[TextData[{
 "Oblicz ca\[LSlash]ki oznaczone z funkcji ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["k", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], 
             StyleBox["x", "TI"]], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "f(x, k) = \\frac{1}{ k^x + 1 }", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "37ede413-94a6-4d35-82af-5d059605f8d3"],
 " w zakresie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[LessEqual]", 
         StyleBox["x", "TI"], "\[LessEqual]", "5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "0 \\le x \\le 5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d251e323-06c8-4909-8007-c453867d9132"],
 " dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "2", ",", 
         "\[Ellipsis]", ",", "6"}], TraditionalForm], "errors" -> {}, "input" -> 
     "k = 1, 2,  \\dotsc, 6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3fdbeff-2dc0-471c-8498-5f478b0dfa05"],
 "."
}], "Text",
