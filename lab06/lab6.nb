Cell[TextData[{
 "Wyznaczy\[CAcute] \:015brodek masy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["x", "TI"], "CM"], ",", 
           SubscriptBox[
            StyleBox["y", "TI"], "CM"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "( x_{ \\text{CM} }, y_{ \\text{CM} } )", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4e7400e-ba44-4543-b34b-fe3d75a8a3fd"],
 " dla jednorodnego \[LSlash]uku zadanego przez krzyw\:0105 z poprzedniego \
zadania, tj.",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "3"], "+", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["x", "TI"], "3"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "f(x) = x^3 + \\frac{1}{ x^3 }", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14b8759f-29dc-4523-8328-97e6fe5e31dd"],
 " dla  \.12",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], "\[LessEqual]", 
         StyleBox["x", "TI"], "\[LessEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\frac{1}{2} \\le x \\le 2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e82a70ce-ec84-46fe-8acb-6eff095d1956"],
 ".\nW tym celu:"
}], "Text",
