fd0d18fddeb5"],

Cell[TextData[{
 "gdzie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "3"], "+", "4", "sin", 
         RowBox[{"(", 
           RowBox[{"5", 
             StyleBox["x", "TI"]}], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "f_n(x) = x^3 + 4 \\sin(5x).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30d3f17f-f0e5-4470-bbdf-9d25980d739b"]
