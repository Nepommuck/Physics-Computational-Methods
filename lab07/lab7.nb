Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox["\[Integral]", 
         RowBox[{
           SubscriptBox[
            StyleBox["f", "TI"], "1"], "(", 
           StyleBox["x", "TI"], ")"}], 
         RowBox[{
           SubscriptBox[
            StyleBox["f", "TI"], "2"], "(", 
           StyleBox["x", "TI"], ")"}]], 
        FractionBox[
         StyleBox["x", "TI"], 
         StyleBox["S", "TI"]], 
        StyleBox["d", FontSlant -> "Plain"], 
        StyleBox["y", "TI"], "\[LongEqual]", 
        FractionBox[
         StyleBox["x", "TI"], 
         StyleBox["S", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            SubscriptBox[
             StyleBox["f", "TI"], "2"], 
            RowBox[{"(", 
              StyleBox["x", "TI"], ")"}], "-", 
            SubscriptBox[
             StyleBox["f", "TI"], "1"], 
            RowBox[{"(", 
              StyleBox["x", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "\\int_{f_1(x)}^{f_2(x)} \\frac{x}{S} \\mathrm{d} y = \\frac{x}{S} ( \
f_2(x) - f_1(x) )", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"ae582b2a-3c92-4a11-96ea-aaa7c54cb2c6"]], \
"Text",
 CellChangeTimes->{
  3.972794878937613*^9},ExpressionUUID->"98171018-f314-42e3-ad40-\
f689764af507"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["x", "TI"], "CM"], "\[LongEqual]", 
        SubsuperscriptBox["\[Integral]", "0", "1"], 
        SubsuperscriptBox["\[Integral]", 
         RowBox[{
           SubscriptBox[
            StyleBox["f", "TI"], "1"], "(", 
           StyleBox["x", "TI"], ")"}], 
         RowBox[{
           SubscriptBox[
            StyleBox["f", "TI"], "2"], "(", 
           StyleBox["x", "TI"], ")"}]], 
        FractionBox[
         StyleBox["x", "TI"], 
         StyleBox["S", "TI"]], 
        StyleBox["d", FontSlant -> "Plain"], 
        StyleBox["y", "TI"], 
        StyleBox["d", FontSlant -> "Plain"], 
        StyleBox["x", "TI"], "\[LongEqual]", 
        SubsuperscriptBox["\[Integral]", "0", "1"], 
        FractionBox[
         StyleBox["x", "TI"], 
         StyleBox["S", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            SubscriptBox[
             StyleBox["f", "TI"], "2"], 
            RowBox[{"(", 
              StyleBox["x", "TI"], ")"}], "-", 
            SubscriptBox[
             StyleBox["f", "TI"], "1"], 
            RowBox[{"(", 
              StyleBox["x", "TI"], ")"}]}], ")"}], 
        StyleBox["d", FontSlant -> "Plain"], 
        StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "x_{ \\text{CM} } = \\int_0^1 \\int_{f_1(x)}^{f_2(x)} \\frac{x}{S} \
\\mathrm{d} y  \\mathrm{d} x = \\int_0^1 \\frac{x}{S} ( f_2(x) - f_1(x) ) \
\\mathrm{d} x", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"8f3d140d-2426-4eeb-a4f8-5c0fc308722d"]], \
"Text",
 CellChangeTimes->{
  3.972795028524481*^9},ExpressionUUID->"e822527b-e2c8-4d9f-8545-\
a5b76ebd4954"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"xCM", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "/", "S"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f2", "[", "x", "]"}], " ", "-", " ", 
       RowBox[{"f1", "[", "x", "]"}]}], ")"}]}], " ", ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "xMin", ",", " ", "xMax"}], "}"}]}], 
   "]"}]}]], "Input",
