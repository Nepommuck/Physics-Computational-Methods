Cell[BoxData[
 RowBox[{"xCM", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"x", "/", "S"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "xMin", ",", " ", "xMax"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", 
      RowBox[{"f1", "[", "x", "]"}], ",", " ", 
      RowBox[{"f2", "[", "x", "]"}]}], "}"}]}], "]"}]}]], "Input",
