Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["x", "TI"], "CM"], "\[LongEqual]", 
        SubsuperscriptBox["\[Integral]", "0", "1"], 
        SubsuperscriptBox["\[Integral]", 
         RowBox[{
           SubscriptBox[
            StyleBox["f", "TI"], "1"], "(", 
           StyleBox["x", "TI"], ")"}], 
         RowBox[{
           SubscriptBox[
            StyleBox["f", "TI"], "2"], "(", 
           StyleBox["x", "TI"], ")"}]], 
        FractionBox[
         StyleBox["x", "TI"], 
         StyleBox["S", "TI"]], 
        StyleBox["d", FontSlant -> "Plain"], 
        StyleBox["y", "TI"], 
        StyleBox["d", FontSlant -> "Plain"], 
        StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "x_{ \\text{CM} } = \\int_0^1 \\int_{f_1(x)}^{f_2(x)} \\frac{x}{S} \
\\mathrm{d} y  \\mathrm{d} x", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"2ef3bf70-ca29-46ab-ae92-d69dc9ae4683"]], \
