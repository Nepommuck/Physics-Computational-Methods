Cell[CellGroupData[{

Cell[TextData[{
 "Zadanie 1. Ca\[LSlash]ki po konturze, ca\[LSlash]ka niezorientowana, ",
 Cell[BoxData[
 "Integrate"], "InlineCode",ExpressionUUID->
  "a1519990-d414-6b45-80f8-0b022f54bc95"],
 ", ",
 Cell[BoxData[
 "ParametricPlot"], "InlineCode",ExpressionUUID->
  "72055a20-f4bc-784b-a4f7-c25876e853d8"],
 ", ",
 Cell[BoxData[
 "Norm"], "InlineCode",ExpressionUUID->"2dc8e065-78fd-3d4b-8081-35d05b580607"],
 ", ",
 Cell[BoxData[
 "Region"], "InlineCode",ExpressionUUID->
  "72e59a79-37fa-474b-9fcc-37f6bf17bd58"],
 ", ",
 Cell[BoxData[
 "NIntegrate"], "InlineCode",ExpressionUUID->
  "06950418-624c-9d40-b8f6-b86dfb024f9d"],
 ", ",
 Cell[BoxData[
 "LineIntegrate"], "InlineCode",ExpressionUUID->
  "693879b8-c31e-4e48-848e-1f0ec6714b27"]
}], "Section",
 CellChangeTimes->{{3.9726179800505314`*^9, 3.972618028754881*^9}, {
  3.97262941784271*^9, 
  3.9726294186018333`*^9}},ExpressionUUID->"8a0b5018-54d9-1b46-810f-\
aa4ca6d8fd09"],

Cell[TextData[{
 "Oblicz ca\[LSlash]k\:0119 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[ContourIntegral]", "reg"], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["s", "TI"], ")"}], 
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\oint_{ \\text{reg} } f(s) \\mathrm{d}s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c368f773-2267-49d7-b6b9-41146679c5b4"],
 " z funkcji  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["y", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "f(x, y) = x^2 + y^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5f939d7-e738-405c-a257-01e29a51f1f7"],
 " po eliptycznym konturze ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3387d2a7-2862-45f2-b7b8-34e1bdef420f"],
 " zadanym przez elips\:0119 o p\[OAcute]\[LSlash]osiach ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["x", "TI"]], "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r_{x} = 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14068b8a-9f8b-478d-bff1-bb85d72b07b1"],
 " oraz ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["y", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r_y = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac186edc-cf64-433e-be2e-079c9f8a1501"],
 ".\nZadana ca\[LSlash]ka to ca\[LSlash]ka niezorientowana, tj. nie ma \
znaczenia kierunek ca\[LSlash]kowania po krzywej, argument funkcji ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e91bc4a-31e0-4a6c-a5c1-321f131bc147"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[Element]", 
         SuperscriptBox[
          StyleBox["R", FontSlant -> "Bold"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "s \\in \\mathbf{R}^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0303405e-c91b-4345-8763-d047fc4b0048"],
 ", a funkcja zwraca warto\:015b\[CAcute] ze zbioru ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", FontSlant -> "Bold"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbf{R}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b60a814-2a9b-4ee2-8173-5431f5bb8fdb"],
 ".\nZ kolei, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", FontSlant -> "Plain"], 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{d} s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa37b15d-c0a4-434e-8226-18820f6b7469"],
 " mo\:017ce by\[CAcute] intuicyjnie rozumiane jako element d\[LSlash]ugo\
\:015bci krzywej."
}], "Text",
 CellChangeTimes->{
  3.972629474015461*^9, {3.9726295387478447`*^9, 3.972629539760337*^9}, {
   3.972629616535441*^9, 3.972629740062989*^9}, 3.972629776199607*^9, {
   3.9726298774623413`*^9, 
   3.972629928253837*^9}},ExpressionUUID->"a72a02f0-f437-481e-9143-\
cf3b971e9b69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", " ", "y_"}], "}"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "^", "2"}], " ", "+", " ", 
   RowBox[{"y", "^", "2"}]}]}]], "Input",
 CellChangeTimes->{{3.972618420684965*^9, 3.972618440374319*^9}, {
  3.972630454647664*^9, 3.972630456494982*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"1b5c14fd-9306-ab46-947c-60e8a6a63ff0"],

Cell["\<\
W celu obliczenia zadanej ca\[LSlash]ki wykonaj nast\:0119puj\:0105ce \
polecenia:\
\>", "Text",
 CellChangeTimes->{
  3.9726181989233418`*^9},ExpressionUUID->"7198f45d-6cae-7942-8736-\
096b9b409e19"],

Cell[CellGroupData[{

Cell[TextData[{
 "1) Sparametryzuj elips\:0119 korzystaj\:0105c ze zwi\:0105zku ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["r", "TI"], 
              StyleBox["x", "TI"]], "cos", 
             StyleBox["t", "TI"], ",", 
             SubscriptBox[
              StyleBox["r", "TI"], 
              StyleBox["y", "TI"]], "sin", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "c(t) = (r_x \\cos{t}, r_y \\sin{t})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "93e2e70b-feeb-49a8-95de-aec08e380858"],
 " dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[LessEqual]", 
         StyleBox["t", "TI"], "\[LessEqual]", "2", "\[Pi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "0 \\le t \\le 2 \\pi", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ecc0d8f-2b95-45d4-afa7-91d7a1c530d2"],
 " "
}], "Subsection",
 CellChangeTimes->{{3.9726182164885063`*^9, 3.972618222035864*^9}, {
  3.9726299917172728`*^9, 3.972629992353125*^9}, {3.9726300227856493`*^9, 
  3.972630042055401*^9}},ExpressionUUID->"f1cefb91-00b5-5e45-b01d-\
b7f36e5dd280"],

Cell[TextData[{
 "Narysuj t\:0119 elips\:0119 korzystaj\:0105c z ",
 Cell[BoxData[
 "ParametricPlot"], "InlineCode",ExpressionUUID->
  "76db7190-bce2-45dd-b1cc-a9d750f7007c"]
}], "Text",
 CellChangeTimes->{{3.9726182241788692`*^9, 3.972618227979891*^9}, {
  3.972630057693549*^9, 
  3.972630060229899*^9}},ExpressionUUID->"e6c1e737-0669-fc40-b876-\
a30d75b64f20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rx", ",", " ", "ry"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tMin", ",", " ", "tMax"}], "}"}], " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"2", "\[Pi]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rx", " ", "*", " ", 
      RowBox[{"Cos", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"ry", " ", "*", " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"c", "[", "t", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "tMin", ",", " ", "tMax"}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.972618069399906*^9, 3.9726181778767242`*^9}, {
   3.9726182804632053`*^9, 3.972618288511753*^9}, {3.9726183625702343`*^9, 
