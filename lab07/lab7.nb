Cell[TextData[{
 "2) Przedstaw na tym samy wykresie pole wektorowe ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["v", "TI"], "\[RightVector]"], "(", 
         RowBox[{
           StyleBox["x", "TI"], ",", 
           StyleBox["y", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\vec{v} (x, y)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
