Cell[TextData[{
 "6) Dla rozk\[LSlash]adu masy zadanego przez ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ",", 
             StyleBox["z", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["n", "TI"]], 
          StyleBox["V", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SuperscriptBox[
               StyleBox["x", "TI"], "2"], "+", 
              SuperscriptBox[
               StyleBox["y", "TI"], "2"], "+", 
              SuperscriptBox[
               StyleBox["z", "TI"], "2"]}], ")"}], 
          FractionBox[
           StyleBox["n", "TI"], "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\rho_n(x, y, z) = \\frac{m_n}{V} ( x^2 + y^2 + z^2 )^{ \\frac{n}{2} }",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2aa35d3-3c05-4951-b91b-2c5b38246f72"],
 " dla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["x", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["y", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["z", "TI"], "2"]}]], "\[LessEqual]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sqrt{ x^2 + y^2 + z^2 } \\le r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e97d96f-13ba-468c-b925-aaad4f950cc5"],
 ", gdzie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0c24cde-e309-4f59-af5f-343535dce841"],
 " jest liczb\:0105 naturaln\:0105, sprawd\:017a przy jakim ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c23770f0-763e-4e66-bfdc-5effc7787330"],
