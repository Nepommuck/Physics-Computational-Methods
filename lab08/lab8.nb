             StyleBox["m", "TI"], "1"], 
            StyleBox["V", "TI"]], ",", 
           FractionBox[
            SubscriptBox[
             StyleBox["m", "TI"], "2"], 
            StyleBox["V", "TI"]]}], ")"}], TraditionalForm], "errors" -> {}, 
