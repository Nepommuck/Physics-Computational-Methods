Cell[TextData[{
 "Rozwa\:017cy\[CAcute] jednorodny walec o masie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5313b305-cfba-494e-b3f8-182c1371d17b"],
 ", wysoko\:015bci ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["l", "TI"], TraditionalForm], "errors" -> {}, "input" -> "l", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "530135e5-a202-4a56-9566-8c7e0fa1cfea"],
 " oraz promieniu ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8fac0058-f57d-4232-aaf0-be3f21d8a1e0"],
 ".\nDla ustalenia orientacji przestrzennej walca przyj\:0105\[CAcute], \
\:017ce jego \:015brodek masy jest w punkcie ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "CM"], ",", 
             SubscriptBox[
              StyleBox["y", "TI"], "CM"], ",", 
             SubscriptBox[
              StyleBox["z", "TI"], "CM"]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"0", ",", "0", ",", "0"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "(x_{ \\text{CM} }, y_{ \\text{CM} }, z_{ \\text{CM} }) = (0, 0, 0)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac3fd142-d25d-48b5-946d-331160ecc0fa"],
 ",\na o\:015b symetrii obrotowej jest zadana przez punkty ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"0", ",", "0", ",", "-", 
           FractionBox[
            StyleBox["l", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(0, 0, -\\frac{l}{2})", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96a63436-3f2b-4e7b-a7c1-47eca354e1ef"],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"0", ",", "0", ",", 
           FractionBox[
            StyleBox["l", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(0, 0, \\frac{l}{2})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "358f27a7-99f7-4109-8cb7-b0d0dfba6b32"],
 ". \nW celu obliczenie momentu bezw\[LSlash]adno\:015bci zadanego walca wzgl\
\:0119dem dowolnej osi wykonaj nast\:0119puj\:0105ce polecenia:"
}], "Text",
