Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenvaluesUniform", " ", "=", " ", 
   RowBox[{"Eigenvalues", "[", "HUniformSym", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"histogramUniform", " ", "=", " ", 
    RowBox[{"Histogram", "[", 
     RowBox[{
     "eigenvaluesUniform", ",", " ", "1000", ",", " ", "\"\<PDF\>\""}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]Uniform", "[", 
     RowBox[{"\[Sigma]_", ",", " ", "N_"}], "]"}], "[", "E_", "]"}], " ", ":=",
