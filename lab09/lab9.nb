Cell[TextData[{
 "7) Na wykresie z ",
 StyleBox["6)",
  FontWeight->"Bold"],
 " nanie\:015b zale\:017cno\:015b\[CAcute] teoretyczn\:0105 opisuj\:0105c\
\:0105 p\[OAcute]\[LSlash]kole Wignera z odpowiednio dobranymi parametrami ",
