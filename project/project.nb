Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CalculateAcceleration", "[", 
    RowBox[{"body_", ",", " ", "other_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "distVec", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"distVec", " ", "=", " ", 
       RowBox[{
        RowBox[{"body", "[", "\"\<position\>\"", "]"}], " ", "-", " ", 
        RowBox[{"other", "[", "\"\<position\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"-", " ", "G"}], " ", "*", " ", 
       RowBox[{
        RowBox[{"other", "[", "\"\<mass\>\"", "]"}], " ", "/", " ", 
        RowBox[{
         RowBox[{"Norm", "[", "distVec", "]"}], "^", "3"}]}], " ", "*", " ", 
       "distVec"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SimulateStep", "[", 
    RowBox[{"body_", ",", " ", "remainingBodies_", ",", " ", "dt_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "accelerationVec", ",", " ", "newVelocityVec", ",", " ", 
       "newPositionVec"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"accelerationVec", " ", "=", " ", 
       RowBox[{"Total", "[", 
        RowBox[{"Map", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"otherBody", " ", "|->", " ", 
           RowBox[{"CalculateAcceleration", "[", 
            RowBox[{"body", ",", " ", "otherBody"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "remainingBodies"}], "\[IndentingNewLine]", 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"newVelocityVec", " ", "=", " ", 
       RowBox[{
        RowBox[{"body", "[", "\"\<velocity\>\"", "]"}], " ", "+", " ", 
        RowBox[{"accelerationVec", " ", "*", " ", "dt"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"newPositionVec", " ", "=", " ", 
       RowBox[{
        RowBox[{"body", "[", "\"\<position\>\"", "]"}], " ", "+", " ", 
        RowBox[{"newVelocityVec", " ", "*", " ", "dt"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Append", "[", 
       RowBox[{"body", ",", " ", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<velocity\>\"", " ", "->", " ", "newVelocityVec"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"\"\<position\>\"", " ", "->", " ", "newPositionVec"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"\"\<positionHistory\>\"", " ", "->", " ", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"body", "[", "\"\<positionHistory\>\"", "]"}], ",", " ", 
             
             RowBox[{"body", "[", "\"\<position\>\"", "]"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simulate", "[", 
   RowBox[{"initialBodies_", ",", " ", "totalTime_", ",", " ", "nSteps_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dt", ",", " ", "time", ",", " ", "bodies"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dt", " ", "=", " ", 
      RowBox[{"N", "[", 
       RowBox[{"totalTime", " ", "/", " ", "nSteps"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"time", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"bodies", " ", "=", " ", "initialBodies"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"time", " ", "<", " ", "totalTime"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bodies", " ", "=", " ", 
         RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"body", ",", " ", "idxArr"}], "}"}], " ", "|->", " ", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", "index", "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"{", "index", "}"}], " ", "=", " ", "idxArr"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"SimulateStep", "[", 
                RowBox[{"body", ",", " ", 
                 RowBox[{"Delete", "[", 
                  RowBox[{"bodies", ",", " ", "index"}], "]"}], ",", " ", 
                 "dt"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ",", 
           "\[IndentingNewLine]", "bodies"}], "\[IndentingNewLine]", "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"time", " ", "+=", " ", "dt"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "bodies"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
