  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GetFrameTable", "[", 
    RowBox[{"bodies_", ",", " ", "totalRawFrames_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"targetFrameCount", ",", "stepSize"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"targetFrameCount", "=", 
       RowBox[{"GifFPS", "*", "GifTotalDurationSeconds"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"stepSize", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"totalRawFrames", "-", "1"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"targetFrameCount", "-", "1"}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PlotFrame", "[", 
         RowBox[{"bodies", ",", 
          RowBox[{"Round", "[", "i", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1.0", ",", "totalRawFrames", ",", "stepSize"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExportAsGif", "[", 
   RowBox[{"bodies_", ",", " ", "filename_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"numberOfFrames", ",", " ", "frames"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"numberOfFrames", " ", "=", " ", 
      RowBox[{"Length", "[", 
       RowBox[{
        RowBox[{"First", "[", "bodies", "]"}], "[", "\"\<positionHistory\>\"",
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"frames", " ", "=", " ", 
      RowBox[{"GetFrameTable", "[", 
       RowBox[{"bodies", ",", " ", "numberOfFrames"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"filename", " ", "<>", " ", "\"\<.gif\>\""}], ",", 
       "\[IndentingNewLine]", "frames", ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<DisplayDurations\>\"", " ", "->", " ", 
        RowBox[{"1.0", "/", "GifFPS"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<AnimationRepetitions\>\"", " ", "->", " ", "1"}]}], 
